

# Gmail accounts the app sends from (use app passwords). Quotation mails, and sales-order / invoice mails to customers:
SMTP_QUOTE_USER=
SMTP_QUOTE_PASS=
SMTP_SALES_USER=
SMTP_SALES_PASS=

# Optional: lets the website chat assistant answer free-form questions with Claude (it still only uses the shop's own products, prices and policies).
# Without it the built-in assistant answers product, budget, delivery, payment, servicing and policy questions on its own.
ANTHROPIC_API_KEY=
# CHAT_MODEL=claude-haiku-5-5
