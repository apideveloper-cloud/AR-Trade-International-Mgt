# copy to server/.env on the live server and fill in. Do NOT commit this file.
PORT=4000
NODE_ENV=production
# the public https address of the shop: used for canonical links, the sitemap and links inside emails
SITE_URL=https://artradeinternational.birgroupholdings.net
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=artradeint_mgt
DB_USER=mithu_console
DB_PASS=<the mithu_console database password>
JWT_SECRET=<run: openssl rand -hex 32>
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# optional: outgoing email (invoice emails, marketing, contact form). Without SMTP_HOST nothing is sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AR Trade International <sales@artradeinternational.com>
